# One key. Nothing else is required.
#
# A plain "provider/model" string routes through the AI SDK gateway, so this one
# key can reach several providers. Use a provider key directly if you prefer;
# see the AI SDK documentation for the variable each provider reads.
AI_GATEWAY_API_KEY=

# Which corpus to serve, relative to the repository root.
# The default is data/riftbound. Build a corpus before you serve it.
# RULEKIT_CORPUS=data/chess

# Which model to use.
# RULEKIT_MODEL=anthropic/claude-sonnet-5
