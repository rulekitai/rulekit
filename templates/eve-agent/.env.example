# Copy this file to .env and fill in the credential.
#
#     cp .env.example .env
#
# .env is in .gitignore. This file is not, so write no real key here.

# The model credential. Required.
# A "provider/model" string routes through the AI SDK gateway, which reads this
# variable. Use the variable your own provider names instead when you pass a
# provider module.
AI_GATEWAY_API_KEY=

# Which corpus to serve. Optional. Default data/riftbound.
# RULEKIT_CORPUS=data/riftbound

# The model. Optional. Default anthropic/claude-sonnet-5.
# RULEKIT_MODEL=anthropic/claude-sonnet-5

# A ceiling on model calls per question. Optional. Default none, as in production.
# RULEKIT_STEP_CAP=8

# A shared secret the ask channel checks. Optional.
# Set it when something other than this agent posts to the channel.
# RULEKIT_INTERNAL_SECRET=
