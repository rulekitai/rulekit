{
  "name": "rulekit-monorepo",
  "version": "0.5.0",
  "private": true,
  "description": "A grounded, citable rules assistant you can run over your own rulebook.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "node packages/rulekit/scripts/copy-shipped-files.mjs && node packages/ui/scripts/copy-notice.mjs && tsc --build",
    "check-types": "tsc --build --force",
    "clean": "tsc --build --clean",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "node --conditions=rulekit-source --no-warnings --test \"packages/*/src/**/*.test.ts\"",
    "rulekit": "node --conditions=rulekit-source --no-warnings packages/rulekit/src/cli/bin.ts",
    "test:e2e": "pnpm --filter rulekit-example test:e2e",
    "compare-runtimes": "node --conditions=rulekit-source --no-warnings scripts/compare-runtimes.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@rulekitai/rulekit": "workspace:*",
    "@types/node": "22",
    "typescript": "^7.0.2"
  }
}
