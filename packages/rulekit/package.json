  "scripts": {
    "build": "node ./scripts/copy-shipped-files.mjs && tsc --build",
    "test": "node --test src/**/*.test.ts"
  },
  "dependencies": {
    "zod": "^4.4.0"
  },
  "peerDependencies": {
