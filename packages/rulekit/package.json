    },
    "./pipeline/stages/static-render": {
      "types": "./dist/pipeline/stages/static-render.d.ts",
      "rulekit-source": "./src/pipeline/stages/static-render.ts",
      "default": "./dist/pipeline/stages/static-render.js"
    },
    "./pipeline/stages/cache": {
      "types": "./dist/pipeline/stages/cache.d.ts",
