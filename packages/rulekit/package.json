{
  "name": "@rulekitai/rulekit",
  "version": "0.4.0",
  "description": "A grounded rules assistant: the corpus, the agent, the answer pipeline, the HTTP handler, and the rulekit command.",
  "keywords": [
    "rules",
    "rulebook",
    "rules-assistant",
    "citations",
    "grounded",
    "rag",
    "sqlite",
    "ai-sdk",
    "llm",
    "cli"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/rulekitai/rulekit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rulekitai/rulekit.git",
    "directory": "packages/rulekit"
  },
  "bugs": {
    "url": "https://github.com/rulekitai/rulekit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "files": [
    "dist",
    "src",
    "data",
    "docs",
    "skills",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "bin": {
    "rulekit": "./dist/cli/bin.js"
  },
