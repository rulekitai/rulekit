{
  "name": "@rulekitai/corpus",
  "version": "0.1.0",
  "description": "The rules corpus: a JSON schema, a SQLite builder, and one read interface.",
  "keywords": [
    "rules",
    "rulebook",
    "rules-assistant",
    "citations",
    "grounded",
    "rag",
    "sqlite",
    "full-text-search",
    "json-schema"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/rulekitai/rulekit/tree/main/packages/corpus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rulekitai/rulekit.git",
    "directory": "packages/corpus"
  },
  "bugs": {
    "url": "https://github.com/rulekitai/rulekit/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./schema": {
      "types": "./dist/schema.d.ts",
      "development": "./src/schema.ts",
      "default": "./dist/schema.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "development": "./src/types.ts",
      "default": "./dist/types.js"
    },
    "./load": {
      "types": "./dist/load.d.ts",
      "development": "./src/load.ts",
      "default": "./dist/load.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "development": "./src/build.ts",
      "default": "./dist/build.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "development": "./src/store.ts",
      "default": "./dist/store.js"
    },
    "./sqlite-store": {
      "types": "./dist/sqlite-store.d.ts",
      "development": "./src/sqlite-store.ts",
      "default": "./dist/sqlite-store.js"
    },
    "./json-store": {
      "types": "./dist/json-store.d.ts",
      "development": "./src/json-store.ts",
      "default": "./dist/json-store.js"
    },
    "./text": {
      "types": "./dist/text.d.ts",
      "development": "./src/text.ts",
      "default": "./dist/text.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "test": "node --test src/**/*.test.ts"
  },
  "dependencies": {
    "zod": "^4.4.0"
  }
}
