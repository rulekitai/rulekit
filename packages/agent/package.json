{
  "name": "@rulekitai/agent",
  "version": "0.1.1",
  "description": "Tools, instructions, skills, and a runtime for a grounded rules assistant.",
  "keywords": [
    "rules",
    "rulebook",
    "rules-assistant",
    "citations",
    "grounded",
    "rag",
    "ai-sdk",
    "llm",
    "tools",
    "agent"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/rulekitai/rulekit/tree/main/packages/agent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rulekitai/rulekit.git",
    "directory": "packages/agent"
  },
  "bugs": {
    "url": "https://github.com/rulekitai/rulekit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./tools": {
      "types": "./dist/tools.d.ts",
      "development": "./src/tools.ts",
      "default": "./dist/tools.js"
    },
    "./profile": {
      "types": "./dist/profile.d.ts",
      "development": "./src/profile.ts",
      "default": "./dist/profile.js"
    },
    "./instructions": {
      "types": "./dist/instructions.d.ts",
      "development": "./src/instructions.ts",
      "default": "./dist/instructions.js"
    },
    "./turn": {
      "types": "./dist/turn.d.ts",
      "development": "./src/turn.ts",
      "default": "./dist/turn.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "development": "./src/events.ts",
      "default": "./dist/events.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "development": "./src/runtime.ts",
      "default": "./dist/runtime.js"
    },
    "./skills": {
      "types": "./dist/skills.d.ts",
      "development": "./src/skills.ts",
      "default": "./dist/skills.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "test": "node --test src/**/*.test.ts"
  },
  "dependencies": {
    "@rulekitai/corpus": "workspace:*",
    "zod": "^4.4.0"
  },
  "peerDependencies": {
    "ai": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  }
}
