{
  "name": "@rulekitai/react",
  "version": "0.1.0",
  "description": "Headless React hooks for a rules chat. No styling.",
  "keywords": [
    "rules",
    "rulebook",
    "rules-assistant",
    "citations",
    "grounded",
    "rag",
    "react",
    "hooks",
    "headless",
    "streaming"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/rulekitai/rulekit/tree/main/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rulekitai/rulekit.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/rulekitai/rulekit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./message": {
      "types": "./dist/message.d.ts",
      "development": "./src/message.ts",
      "default": "./dist/message.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "development": "./src/storage.ts",
      "default": "./dist/storage.js"
    },
    "./use-ask-stream": {
      "types": "./dist/use-ask-stream.d.ts",
      "development": "./src/use-ask-stream.ts",
      "default": "./dist/use-ask-stream.js"
    },
    "./use-chat-sessions": {
      "types": "./dist/use-chat-sessions.d.ts",
      "development": "./src/use-chat-sessions.ts",
      "default": "./dist/use-chat-sessions.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "test": "node --test src/**/*.test.ts"
  },
  "dependencies": {
    "@rulekitai/agent": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0"
  }
}
