{
  "name": "@rulekit/server",
  "version": "0.1.0",
  "description": "One web-standard HTTP handler that mounts anywhere.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "files": [
