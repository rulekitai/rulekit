{
  "name": "@rulekitai/server",
  "version": "0.1.0",
  "description": "One web-standard HTTP handler that mounts anywhere.",
  "keywords": [
    "rules",
    "rulebook",
    "rules-assistant",
    "citations",
    "grounded",
    "rag",
    "http",
    "web-standards",
    "route-handler"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/rulekitai/rulekit/tree/main/packages/server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rulekitai/rulekit.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/rulekitai/rulekit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./handler": {
      "types": "./dist/handler.d.ts",
      "development": "./src/handler.ts",
      "default": "./dist/handler.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "test": "node --test src/**/*.test.ts"
  },
  "dependencies": {
    "@rulekitai/corpus": "workspace:*",
    "@rulekitai/agent": "workspace:*",
    "@rulekitai/pipeline": "workspace:*"
  }
}
