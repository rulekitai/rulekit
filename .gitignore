node_modules/
dist/
*.tsbuildinfo
.next/
out/

# Built corpora. The JSON beside them is the source of truth; the database file
# is a build artefact that `rulekit build` reproduces in under a second.
*.db
*.db-journal
*.db-wal
*.db-shm

.env
.env.local
.DS_Store

# Local probing scripts, not part of the project.
.scratch/

# Eve build output.
.eve/
.output/

# Playwright output.
test-results/
playwright-report/
blob-report/
packages/rulekit/data/
# Copied from the root NOTICE at build time, so Apache 2.0 4(d) travels with
# each published package. The root NOTICE is the original.
packages/rulekit/NOTICE
packages/ui/NOTICE

# Copied from the root at build time, so a reader who installed from npm holds
# the documents the README links and the list of what changed. The copies at the
# root are the originals.
packages/rulekit/docs/
packages/rulekit/skills/
packages/rulekit/CHANGELOG.md
packages/ui/CHANGELOG.md
