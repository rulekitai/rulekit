      "rule_number": "300.2",
      "slug": "blocking",
      "title": "Blocking",
      "content": "The defending player may assign each of their untapped units to block one attacking unit. An attacking unit that is blocked deals no damage to the defending player.",
      "example": null,
      "depth": 0,
      "display_order": 1,
      "rule_type": "rule",
      "keywords": ["Guard"],
      "cross_references": ["800.1", "300.3"],
