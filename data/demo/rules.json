      "rule_number": "100.1",
      "slug": "the-deck",
      "title": "The Deck",
      "content": "A deck contains exactly 40 cards. A deck may contain at most 3 copies of any card with the same name, unless that card says otherwise.",
      "example": "A deck holding four copies of Stonewall Sentry is illegal, because no card grants an exception to the 3-copy limit.",
      "depth": 0,
      "display_order": 0,
      "rule_type": "rule",
      "keywords": [],
      "cross_references": ["100.2"],
      "is_deprecated": false,
      "deprecation_note": null
    },
