      "parent_id": "r-300-2",
      "rule_number": "300.2.a",
      "slug": "guard-restriction",
      "title": null,
      "content": "If the defending player controls a unit with Guard, every attacking unit must be blocked by a unit with Guard before any other unit may block.",
      "example": "The defender controls Stonewall Sentry, which has Guard. A second unit without Guard cannot block until Stonewall Sentry is blocking or is unable to block.",
      "depth": 1,
      "display_order": 0,
      "rule_type": "sub_rule",
      "keywords": ["Guard"],
      "cross_references": ["800.1"],
      "is_deprecated": false,
